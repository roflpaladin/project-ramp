# =============================================================================
# Dev vs prod — read docs/environments.md before filling this in.
#
# We run TWO separate Supabase projects, never one shared between environments:
#   - DEV  project  -> local `next dev`, vitest live tests, and Playwright E2E.
#                      Its keys go in .env.local (git-ignored) on your machine.
#   - PROD project  -> the deployed app only. Its keys live in the host's
#                      env-var settings (e.g. Vercel, Production scope), NOT here.
#
# playwright.config.ts and vitest.config.ts both load .env.local, so whatever
# project .env.local points at is the project your tests read and WRITE. The
# live tests run real DDL and seed real rows — point .env.local at DEV so a
# test run can never mutate prod.
#
# The three *_SECRET / signing values below MUST be generated fresh PER
# environment (`openssl rand -hex 32`). Never copy a dev secret into prod or
# vice-versa — a leaked dev secret must not authenticate against prod.
# =============================================================================

# Supabase project (placeholders — replace with real values from your Supabase project settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used to read/write workspaces & links for buyer /portal routes,
# where the visitor is authenticated via a magic-link token, not Supabase Auth,
# and therefore can't satisfy the tenant_id RLS policies. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs the buyer's portal-access cookie after a magic-link code is verified.
# Any long random string; generate with e.g. `openssl rand -hex 32`.
PORTAL_SESSION_SECRET=replace-with-a-long-random-string

# Shared secret the CRM relay must send on every deal-stage webhook
# (X-Ramp-Webhook-Secret header, or Authorization: Bearer <secret>). The
# HubSpot & Salesforce webhook routes reject any call without it — provisioning
# a workspace inside a real tenant must never be triggerable by an unauthenticated
# POST. Generate with e.g. `openssl rand -hex 32`. If unset, all webhooks 401.
CRM_WEBHOOK_SECRET=replace-with-a-long-random-string

# Resend API used to send the buyer's six-digit access code (Sprint 11, Ticket 57;
# replaced the SMTP relay -- see docs/adr/0001-transactional-email-provider.md).
# Create a key at resend.com with sending access for your verified domain.
# If unset, sends fail soft ({ ok: false }, logged) without throwing.
RESEND_API_KEY=re_your-api-key
RESEND_FROM="Project Ramp <noreply@yourdomain.com>"

# Optional. Daily cap on ALL transactional email sent through Resend (buyer
# access codes + password resets), across every tenant (Sprint 12, Ticket 63).
# Unset = 90, sized under Resend's free plan (100/day, 3,000/month). Raise it
# only after upgrading the Resend plan. Must be a positive whole number;
# anything else falls back to 90 and logs a server error.
# EMAIL_DAILY_LIMIT=90

# Optional but strongly recommended on deployed environments. Canonical origin
# used for the "Open your deal room" link in invite emails (Sprint 8, Ticket 43,
# app/admin/workspaces/[id]/invite-actions.ts). When set, it wins over the
# request's forwarded Host headers, which are client-influenceable on hosts
# without a sanitizing edge proxy — an emailed link must never be buildable
# from an attacker-shaped Host. Include the scheme, no trailing slash.
NEXT_PUBLIC_APP_URL=https://getbrava.tech

# Optional. Days of buyer silence before a workspace with an open buyer-owned
# step counts as "stalled" on the seller dashboard (lib/plans/engagement.ts,
# via lib/plans/stall-threshold.ts). Must be a positive integer; an unset,
# blank, or invalid value falls back to the default of 5. Sprint 7, Ticket 36.
PLAN_STALL_THRESHOLD_DAYS=5

# Sprint 10, Ticket 52 — HubSpot OAuth app credentials (lib/hubspot/env.ts).
# From your HubSpot app's Auth settings. The redirect URI registered on that
# HubSpot app MUST exactly match NEXT_PUBLIC_APP_URL above +
# /api/integrations/hubspot/oauth/callback for EACH environment (dev, every
# Vercel preview origin if used, and prod) — HubSpot rejects a callback whose
# redirect_uri doesn't byte-for-byte match what's registered, so this is a
# per-environment registration, not a one-time setup.
HUBSPOT_CLIENT_ID=your-hubspot-app-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-app-client-secret

# Sprint 11, Ticket 55 — Salesforce OAuth app credentials (lib/salesforce/env.ts).
# From the Salesforce External Client App's connected-app settings (Setup ->
# App Manager). The callback registered on that app MUST exactly match
# NEXT_PUBLIC_APP_URL above + /api/integrations/salesforce/oauth/callback for
# EACH environment, same "byte-for-byte match or Salesforce rejects the
# callback outright" rule as HubSpot's redirect_uri above — see
# docs/environments.md. The live ECA also has PKCE forced on (no env var for
# this — lib/salesforce/pkce.ts implements it unconditionally) and grants
# only the `api` + `refresh_token` scopes (lib/salesforce/env.ts's
# SALESFORCE_SCOPES).
SALESFORCE_CLIENT_ID=your-salesforce-connected-app-client-id
SALESFORCE_CLIENT_SECRET=your-salesforce-connected-app-client-secret

# Optional. Salesforce's OAuth login host — defaults to
# https://login.salesforce.com (both prod and this project's dev org, a
# Developer Edition, authenticate against it). Set only for a sandbox org,
# which needs https://test.salesforce.com instead.
SALESFORCE_LOGIN_BASE_URL=https://login.salesforce.com

# AES-256-GCM key encrypting every stored CRM refresh token at rest
# (lib/encrypt-secret.ts, lib/crm-connections/token-store.ts — HubSpot's and,
# as of Sprint 11 Ticket 55, Salesforce's) and signing each provider's own
# OAuth `state` param (lib/hubspot/oauth-state.ts, lib/salesforce/oauth-state.ts
# — independently keyed subkeys per provider, see lib/app-encryption-key.ts).
# Sprint 12, Ticket 62 added a third consumer on its own subkey: the buyer
# portal's access-code hash (lib/portal-access-token.ts) is an HMAC, so this
# variable is now REQUIRED to issue or verify a code — and required by the
# test suites too (tests/fixtures/env.ts asserts it, .github/workflows/ci.yml
# passes it).
# Exactly 64 hex characters (32 bytes) — generate with `openssl rand -hex 32`,
# fresh per environment, same "never copy a dev secret into prod" rule as the
# other *_SECRET values above.
#
# KNOWN LIMITATION: there is no key-rotation path yet. Rotating this value
# makes every existing encrypted_refresh_token in crm_connections
# undecryptable — every connected tenant would need to reconnect (Settings ->
# Integrations -> Disconnect, then Connect again) after a rotation.
# Acceptable for now; a rotation-safe (multi-key) scheme is a flagged
# follow-up, not built here.
APP_ENCRYPTION_KEY=replace-with-64-hex-characters

# Sprint 12, Ticket 67 — Paddle billing (lib/billing/paddle-env.ts,
# lib/billing/plans.ts). Client-side Paddle.js config for /pricing's overlay
# checkout. NEXT_PUBLIC_ (safe to ship to the browser — this is how Paddle's
# own client token model works) but still validated server-side before
# /pricing renders: getPaddleClientConfig() NEVER silently defaults the
# environment, and refuses a mismatched pair (a "live_" token with
# NEXT_PUBLIC_PADDLE_ENV=sandbox, or a "test_" token with
# NEXT_PUBLIC_PADDLE_ENV=production) — either failure keeps /pricing 404ing
# rather than risk running against the wrong Paddle account.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your-paddle-client-side-token

# One PADDLE_PRICE_<TIER_ID>_<MONTH|YEAR> pair per "checkout" tier defined in
# lib/billing/plans.ts's TIER_DEFINITIONS (currently starter/pro/advanced —
# see CHECKOUT_TIER_IDS). Server-only: read once in app/pricing/page.tsx via
# getPricingModel(), then threaded down as props — never re-read from
# process.env client-side, so none of these need a NEXT_PUBLIC_ prefix.
# Enterprise is NOT a checkout tier (it's invoiced directly by the founder —
# see lib/billing/plans.ts's ContactTier) and has no price ID env vars at
# all. _MONTH is required for every checkout tier for /pricing to be
# publishable; _YEAR is optional, but must be set for EITHER every checkout
# tier or none — a partial yearly rollout is treated as a misconfiguration
# and keeps /pricing 404ing.
PADDLE_PRICE_STARTER_MONTH=pri_your-starter-monthly-price-id
PADDLE_PRICE_STARTER_YEAR=
PADDLE_PRICE_PRO_MONTH=pri_your-pro-monthly-price-id
PADDLE_PRICE_PRO_YEAR=
PADDLE_PRICE_ADVANCED_MONTH=pri_your-advanced-monthly-price-id
PADDLE_PRICE_ADVANCED_YEAR=

# Sprint 12, Ticket 59 — Paddle fulfillment (lib/billing/paddle-server-env.ts).
# The SECRET KEY of the notification destination that points at
# NEXT_PUBLIC_APP_URL + /api/billing/paddle/webhook (Paddle dashboard ->
# Developer tools -> Notifications -> your webhook destination). Prefixed
# `pdl_ntfset_`. Every notification destination has its OWN key, so this is a
# per-environment value like every other secret above — a sandbox key never
# verifies a live webhook.
#
# If this is unset the webhook route processes NOTHING and answers 500: a
# billing endpoint that accepts unverifiable events is worse than one that is
# down. Signature scheme (confirmed against Paddle's docs, 2026-09-20):
# HMAC-SHA256 over "<ts>:<raw body>" with this key used as-is, compared in
# constant time, with a timestamp tolerance — lib/billing/paddle-signature.ts.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your-notification-destination-secret

# Paddle server-side API key (Paddle dashboard -> Developer tools -> API keys).
# REQUIRED (T59 slice 2) — app/settings/billing's "Manage billing" button
# (openBillingPortalAction, via lib/billing/paddle-portal.ts) calls Paddle's
# Customer Portal API with this key; without it, that button always fails.
# Read only through lib/billing/paddle-server-env.ts, which derives the API
# host from NEXT_PUBLIC_PADDLE_ENV above rather than defaulting to one.
# Server-only: never give this a NEXT_PUBLIC_ prefix — it can read and change
# billing data.
PADDLE_API_KEY=pdl_your-server-side-api-key

# Rate limiter store (Sprint 12, Ticket 62) — lib/rate-limit-durable.ts.
# OPTIONAL. Leave UNSET in production: the limiter then counts in Postgres
# (supabase/migrations/0016_rate_limit_windows.sql), one budget shared by every
# serverless instance. Set to "memory" to count per-instance in process memory
# instead — what vitest.config.ts and the Playwright server do so test runs do
# not inherit each other's spent budgets, and an emergency kill switch if the
# shared store ever misbehaves.
# RATE_LIMIT_STORE=memory
